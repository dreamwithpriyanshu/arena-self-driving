# =============================================================================
# Self-Driving Car Simulation MVP — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.whl
.eggs/

# --- Virtual environment ---
venv/
.venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Project-specific ---
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep

data/human_demonstrations/*
!data/human_demonstrations/.gitkeep
data/autonomous_logs/*
!data/autonomous_logs/.gitkeep

# --- Jupyter ---
.ipynb_checkpoints/

# --- pytest ---
.pytest_cache/
htmlcov/
.coverage

# --- Excluded during refactor ---
scratch/
.env

# Training artifacts and model weights (do not commit large binaries)
artifacts/training_history.jsonl
artifacts/training_history_*.jsonl
artifacts/training_history_*.meta.json
*.pt
*.npy
artifacts/test_agents/
models/
logs/

# Published SARSA baseline is intentionally tracked for fresh installs.
!published/checkpoints/sarsa_q_table.npy
!published/history/
!published/history/*.jsonl
!published/history/*.meta.json
